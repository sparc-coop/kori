@page "/"

<section class="instructions">
    <article class="hero">
        <header>
            <h1>
                Finally,<br />
                edit your copy
                yourself
            </h1>
            <p>
                Simple problem needs simple solution. Kori makes your live content directly editable. Just click the text you want to change and save it instantly.
            </p>
        </header>
        <footer>
            <button>Try Demo</button>
        </footer>
    </article>

    <article>
        <header>
            <span>01</span>
            <h2>Editing Text</h2>
        </header>
            <img src="img/char-editingtext.svg" alt="Editing Text" />
            <p>
                Select [Edit mode] icon to start editing, then select any text and start typing to edit.
            </p>
    </article>

    <article>
        <header>
            <span>02</span>
            <h2>Changing linked text</h2>
        </header>
            <div class="buttons">
                <button class="secondary">Learn More</button>
                <button class="secondary">Learn More</button>
                <button class="secondary">Learn More</button>
                <button class="secondary">Learn More</button>
            </div>
            <p>
                If you change any linked text, it will automatically change other linked text.
            </p>
    </article>

    <article>
        <header>
            <span>03</span>
            <h2>Search text</h2>
        </header>
            <img src="img/char-searchtext.svg" alt="Search Text" />
            <p>
                Click [Search] icon, then type words you'd like to find. Then click the search result to jump to the location.
            </p>
    </article>

    <article>
        <header>
            <span>04</span>
            <h2>Version history</h2>
        </header>
            <img src="img/char-versionhistory.svg" alt="Version History" />
            <p>
                The circular nodes indicate histories. Click the node to view histories. Version history will be saved xyz.
            </p>
    </article>

    <article>
        <header>
            <span>05</span>
            <h2>Publish version</h2>
        </header>
            <img src="img/char-publishversion.svg" alt="Publish Version" />
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
    </article>
</section>

<section class="faq">

</section>

