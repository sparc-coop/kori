    <article class="tovik">
        <figure>
            <img src="img/char-tovikandkori.svg" alt="Tovik and Kori" />
            <figcaption>
                Now, it's time to meet global readers.
            </figcaption>
        </figure>
        <footer>
            <button>Visit Tovik Site</button>
        </footer>
    </article>
    <article class="youtube">
        <figure>
            <img src="img/char-youtubeandkori.svg" alt="YouTube and Kori" />
            <figcaption>
                Some text for the Youtube channel or the page here
            </figcaption>
        </figure>
        <footer>
            <button>Visit Sparc Channel</button>
        </footer>
    </article>
</section>

