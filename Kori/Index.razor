@page "/home"

<section class="hero">
    <h1>
        Finally,<br />
        edit your copy yourself
    </h1>

    <p>
        Simple problem needs simple solution. Kori makes your live content directly editable. Just click the text you want to change and save it instantly.
    </p>

    <button>Try Demo</button>
</section>

<ul class="features">
    <li>
        <h2>No Backend</h2>
        <figure>
            <img src="img/char-edit.svg" alt="I can write copy right on the page" />
            <figcaption>"I can write copy right on the page"</figcaption>
        </figure>
    </li>
    <li>
        <h2>Lightweight</h2>
        <figure>
            <img src="img/char-balance.svg" alt="All I needed is a simple tool" />
            <figcaption>"All I needed is a simple tool"</figcaption>
        </figure>
    </li>
    <li>
        <h2>No Backend</h2>
        <figure>
            <img src="img/char-money.svg" alt="No more subscription!" />
            <figcaption>"No more subscription!"</figcaption>
        </figure>
    </li>
</ul>

<section class="tools">
    <h2>Tools We Support</h2>
    <ul>
        <li>
            <figure>
                <img src="icons/edit.svg" alt="On-page Editing"/>
                <figcaption>On-page Editing</figcaption>
            </figure>
            <p>Update copies exactly where they live on the site, without needing to access the backend.</p>
        </li>
        <li>
            <figure>
                <img src="icons/search.svg" alt="Content Search"/>
                <figcaption>Content Search</figcaption>
            </figure>
            <p>Search for the copy you need, then click to head straight to the editing area.</p>
        </li>
        <li>
            <figure>
                <img src="icons/abtesting.svg" alt="A/B Testing" />
                <figcaption>A/B Testing</figcaption>
            </figure>
            <p>Set up a new test version by clicking and changing elements directly on the page.</p>
        </li>
        <li>
            <figure>
                <img src="icons/timeline.svg" alt="Timeline" />
                <figcaption>Timeline</figcaption>
            </figure>
            <p>Track your edit history and switch between different page versions anytime.</p>
        </li>
    </ul>
</section>

