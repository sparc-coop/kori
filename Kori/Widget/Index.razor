@inherits Sparc.Blossom.Api.BlossomWidget
@page "/sites/{Id}/widget"
@using Kori.Widget.Icons
@using Sparc.Blossom.Spaces
@using Sparc.Blossom.Authentication
@using Sparc.Blossom.Content

<form>
    <fieldset class="mode">
        <button type="button" @onclick="Edit" class="@(Mode == "Edit" ? "active" : "")">
            <EditIcon />
        </button>
        <button type="button" @onclick="Search" class="@(Mode == "Search" ? "active" : "")">
            <SearchIcon />
        </button>
    </fieldset>
    <fieldset class="formatting">
        <button type="button" @onclick="Bold" class="@(IsBold ? "active" : "")">
            <BoldIcon />
        </button>
        <button type="button" @onclick="Italic" class="@(IsItalic ? "active" : "")">
            <ItalicIcon />
        </button>
    </fieldset>
</form>

@inject ISparcSpaces Spaces
@inject ISparcContent Content
@code {
    [Parameter] public required string Id { get; set; } = "";
    string Mode = "";
    bool IsBold = false;
    bool IsItalic = false;
    SparcDomain? Domain;
    string? UserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (!string.IsNullOrEmpty(Id))
            {
                Domain = await Spaces.GetDomainAsync(Id);
                if (Domain is not null)
                    Mode = "Edit";
                await BroadcastAsync("mode", Mode);
                StateHasChanged();
            }
        }
    }

    async Task Edit()
    {
        Mode = "Edit";
        await BroadcastAsync("mode", Mode);
    }

    async Task Search()
    {
        Mode = "Search";
        IsBold = false;
        IsItalic = false;
        await BroadcastAsync("mode", Mode);
    }

    [JSInvokable]
    public async Task Save(TextContent content)
    {
        Console.WriteLine("Saving content:" + content.Text);
    }

    async Task Bold() => await BroadcastAsync("bold", () => IsBold = !IsBold);

    async Task Italic() => await BroadcastAsync("italic", () => IsItalic = !IsItalic);
}
