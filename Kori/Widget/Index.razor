@page "/"
@page "/sites/{Id}/widget"
@using Kori.Widget.Icons

<form>
    <fieldset class="mode">
        <button type="button" @onclick="Edit" class="@(Mode == "Edit" ? "active" : "")">
            <EditIcon />
        </button>
        <button type="button" @onclick="Search" class="@(Mode == "Search" ? "active" : "")">
            <SearchIcon />
        </button>
    </fieldset>
    <fieldset class="formatting">
        <button type="button" @onclick="Bold" class="@(IsBold ? "active" : "")">
            <BoldIcon />
        </button>
        <button type="button" @onclick="Italic" class="@(IsItalic ? "active" : "")">
            <ItalicIcon />
        </button>
    </fieldset>
</form>

@inject IJSRuntime Js
@code {
    [Parameter] public required string Id { get; set; } = "";
    string Mode = "Edit";
    bool IsBold = false;
    bool IsItalic = false;
    IJSObjectReference Kori = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Kori = await Js.ImportAsync("./Widget/Index.razor.js");
            await Kori.InvokeVoidAsync("initialize", DotNetObjectReference.Create(this));
        }
    }

    async Task Edit()
    {
        Mode = "Edit";
    }

    async Task Search()
    {
        Mode = "Search";
    }

    async Task Bold() => await Kori.InvokeVoidAsync("bold");

    [JSInvokable]
    public void Bolded()
    {
        IsBold = !IsBold;
        StateHasChanged();
    }

    async Task Italic() => await Kori.InvokeVoidAsync("italic");

    [JSInvokable]
    public void Italicized()
    {
        IsItalic = !IsItalic;
        StateHasChanged();
    }
}
