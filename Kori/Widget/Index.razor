@inherits Sparc.Blossom.Api.BlossomWidget
@page "/sites/{Id}/widget"
@layout EmptyLayout

@using Kori.Widget.Icons
@using Sparc.Blossom.Spaces
@using Sparc.Blossom.Authentication
@using Sparc.Blossom.Content

<form>
    <fieldset class="mode">
        <button type="button" @onclick="Edit" class="@(Mode == "Edit" ? "active" : "")" title="@(Result?.Text)">
            <EditIcon />
        </button>
        <button type="button" @onclick="Search" class="@(Mode == "Search" ? "active" : "")">
            <SearchIcon />
        </button>
    </fieldset>
</form>

@inject ISparcSpaces Spaces
@inject ISparcContent Content
@code {
    [Parameter] public required string Id { get; set; } = "";
    string Mode = "";
    SparcDomain? Domain;
    string? UserId;
    TextContent? Result = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (!string.IsNullOrEmpty(Id))
            {
                Domain = await Spaces.GetDomainAsync(Id);
                if (Domain is not null)
                    Mode = "Edit";
                await BroadcastAsync("mode", Mode);
                StateHasChanged();
            }
        }
    }

    async Task Edit()
    {
        Mode = "Edit";
        await BroadcastAsync("mode", Mode);
    }

    async Task Search()
    {
        Mode = "Search";
        await BroadcastAsync("mode", Mode);
    }

    [JSInvokable]
    public async Task Save(TextContent content)
    {
        var request = new ContentRequest([content], new(Language.Find(content.LanguageId)), Domain!.ToAbsoluteUrl());
        Result = await Content.UpdateAsync(request);
        await BroadcastAsync("saved", Result);
        await InvokeAsync(StateHasChanged);
    }
}
